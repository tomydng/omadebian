# History control
setopt hist_append
HISTCONTROL=ignoreboth
HISTSIZE=32768
HISTFILESIZE="${HISTSIZE}"

# Set complete path
export PATH="./bin:$HOME/bin:$HOME/.local/bin:/usr/local/bin:$HOME/.local/share/omadebian/bin:/usr/local/go/bin:$HOME/.moon/bin:$PATH"
set +h

export OMADEBIAN_PATH="$HOME/.local/share/omadebian"
