polkit.addRule(function(action, subject) {
    if (action.id !== 'org.freedesktop.policykit.exec' ||
        !subject.local || !subject.active)
        return polkit.Result.NOT_HANDLED;

    // Allow local active sudo-group users to run wg-quick without a
    // password prompt. The polkit password dialog proved to hard-freeze
    // this heavily extended GNOME Shell session (it is rendered by the
    // shell itself), so no dialog may ever be triggered from the toggle.
    // Tunnel management stays restricted to local, active, sudo users.
    if (action.lookup('program') === '/usr/bin/wg-quick' &&
        subject.isInGroup('sudo'))
        return polkit.Result.YES;

    return polkit.Result.NOT_HANDLED;
});
