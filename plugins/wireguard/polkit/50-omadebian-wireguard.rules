polkit.addRule(function(action, subject) {
    if (action.id !== 'org.freedesktop.policykit.exec' ||
        !subject.local || !subject.active)
        return polkit.Result.NOT_HANDLED;

    // Remember the authorization for wg-quick during the session: the
    // password is asked on the first toggle, then never again until logout.
    if (action.lookup('program') === '/usr/bin/wg-quick' &&
        subject.isInGroup('sudo'))
        return polkit.Result.AUTH_KEEP;

    return polkit.Result.NOT_HANDLED;
});
