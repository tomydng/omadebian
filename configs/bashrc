source ~/.local/share/omadebian/defaults/bash/rc

# EXPORT
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"
export LESS='--chop-long-lines --HILITE-UNREAD --ignore-case --incsearch --jump-target=4 --LONG-PROMPT --no-init --quit-if-one-screen --RAW-CONTROL-CHARS --use-color --window=-4'
export RIPGREP_CONFIG_PATH=~/.config/ripgrep/ripgreprc

# Functions
update-all() {
    if command -v flatpak >/dev/null 2>&1; then
        echo "🔄 Updating Flatpak packages..."
        flatpak update -y
    else
        echo "⚠️  Flatpak not found, skipping..."
    fi
 
    if command -v snap >/dev/null 2>&1; then
        echo "🔄 Updating Snap packages..."
        sudo snap refresh
    else
        echo "⚠️  Snap not found, skipping..."
    fi

    echo "✅ All updates completed!"
}

# Aliases
alias ff="fzf --preview 'batcat --style=numbers --color=always {}'"
alias fd='fdfind'
alias python="python3"
alias ld="lazydocker"
alias lg="lazygit"
alias zl="zellij"
alias sshh="cat ~/.ssh/config | grep \"Host \" | cut -d \" \" -f 2 | sort"
alias install='sudo apt install'
alias update='sudo apt update'
alias upgrade='sudo apt upgrade && sudo apt autoremove --purge'
alias purge='sudo apt autoremove --purge'
alias uu='echo "APT update & upgrade...\n " && sudo apt update && sudo apt upgrade -y && sudo apt autoremove --purge && update-all'
alias df='df -h'
alias free='free -h'
alias myip="hostname -I | awk '{print $1}'; curl -s ifconfig.me && echo ' external ip'"
alias x="exit"
alias p="less"
alias d='docker'
alias bat='batcat'
alias v="nvim"
alias n="nvim"
alias vim="nvim"
alias vv="nvim ."
alias cl="clear"
alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gco='git checkout'
alias gcam='git commit --all --message'
alias gl='git pull'
alias ggpull='git pull origin "$(git_current_branch)"'
alias gp='git push'
alias gpd='git push --dry-run'
alias gsw='git switch'
alias gst='git status'
alias gss='git status --short'
alias gsb='git status --short --branch'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias k='kubectl'
alias vpn="sudo wg-quick up wg0"
alias vpnd="sudo wg-quick down wg0"

# Custom sources
if [[ -f "$HOME/.custom_aliases" ]]; then
    source "$HOME/.custom_aliases"
fi

if [[ -f "$HOME/.env" ]]; then
    source "$HOME/.env"
fi
